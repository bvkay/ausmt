# AusMT serving replica: deploy/.env on ausmt-serve. deploy/nectar/provision-serve.sh copies this file
# to deploy/.env the first time it runs and stops until the placeholder below is replaced; then run it
# again. The serve role runs the portal service alone, so only the always-required block of
# deploy/.env.example applies here, and nothing in this file is a secret.

# Host root for the served tree (site-data/, basemap/, logs/caddy/), the mounted data volume.
AUSMT_DATA_DIR=/srv/ausmt

# The GHCR namespace the images were published under: the OWNER variable of deploy/.env.example.
OWNER=REPLACE_WITH_GHCR_OWNER

# Image tag; keep it equal to the tag the curation host runs, so the portal serving a build is the
# portal that build was made for.
TAG=latest

# The curation host's reader listener, which answers the four public gateway routes (provisioning copies it to deploy/frontdoor/.env).
#   e.g. AUSMT_GATEWAY_UPSTREAM=http://ausmt-box:8445    (while the box curates: ausmt-test's AUSMT_BOX_READER_UPSTREAM)
AUSMT_GATEWAY_UPSTREAM=REPLACE_WITH_CURATION_HOST_READER_UPSTREAM

# OPTIONAL: the address the curation host publishes from, as published.json records it under
# "sender" (the client address of the receive's SSH session, so the sender's tailnet address). When
# set, the serve doctor WARNs if the last publish came from any other address, the sign of a second
# host publishing to this replica. Empty, the doctor names the sender without judging it.
#   e.g. AUSMT_PUBLISH_SENDER=100.101.102.103
AUSMT_PUBLISH_SENDER=
