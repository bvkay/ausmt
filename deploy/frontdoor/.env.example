# AusMT public front door - VPS environment (public bridge).
# Copy to deploy/frontdoor/.env on the VPS and fill in. NOTHING here is baked into git: these are the
# only place the public name and the box tailnet name live. `.env` is gitignored (see .gitignore).

# The CANONICAL public name, served with an automatic Let's Encrypt certificate. This is the name
# whose DNS A/AAAA record points at the VPS public IP (for the AuScope name that record lives in a
# zone AuScope administers). The canonical name:
#   e.g. AUSMT_PUBLIC_NAME=ausmt.auscope.org.au
AUSMT_PUBLIC_NAME=

# OPTIONAL: the legacy public name, kept alive as a PERMANENT (301) redirect to the canonical name
# with path and query preserved. Leave empty to serve the canonical name only: install-frontdoor.sh
# renders the redirect site block out of the Caddyfile when this is unset (an empty `{$VAR}` site
# address would otherwise be a Caddy parse error). When set, automatic HTTPS obtains a certificate
# for this name too, so its DNS record must also point at this VPS.
#   e.g. AUSMT_LEGACY_REDIRECT_NAME=ausmt.au
AUSMT_LEGACY_REDIRECT_NAME=

# The box reader upstream, reached over the tailnet by the box's MagicDNS name + the tailscale-serve
# reader port (the port you expose with `tailscale serve --tcp` on the box; the RUNBOOK uses 8445).
# http:// (not https://): the hop runs inside the WireGuard-encrypted tailnet; public TLS is this
# edge's job. Use the box's MagicDNS name, never a raw IP baked into config you might commit.
#   e.g. AUSMT_BOX_READER_UPSTREAM=http://ausmt-box:8445
AUSMT_BOX_READER_UPSTREAM=

# Contact email for the ACME (Let's Encrypt) account. Used only for expiry/issuance notices.
#   e.g. AUSMT_ACME_EMAIL=ops@example.org
AUSMT_ACME_EMAIL=
