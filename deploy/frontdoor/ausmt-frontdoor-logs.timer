# AusMT front-door log-shipping timer. Fires ausmt-frontdoor-logs.service every hour, so a roll the
# front door makes reaches the box long before roll_keep can delete it, and the 03:00 pull lands before
# the 03:35 fold (ausmt-stats). Install:
#   sudo cp deploy/frontdoor/ausmt-frontdoor-logs.{service,timer} /etc/systemd/system/
#   # (edit the __PLACEHOLDER__ paths + User= in the .service first; see that file)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ausmt-frontdoor-logs.timer
#   systemctl list-timers ausmt-frontdoor-logs.timer         # confirm the next run
#   sudo systemctl start ausmt-frontdoor-logs.service        # ship once NOW to test
# See deploy/frontdoor/RUNBOOK.md "Log shipping".

[Unit]
Description=AusMT front-door log shipping every hour (+ jitter), ahead of the C45 fold

[Timer]
# Hourly: the front door rolls its log at 10 MB and keeps a bounded number of rolls, and on busy days
# a once-a-day pull lost rolls. The aggregator only folds COMPLETE days and is idempotent, so the
# exact minute is not load-bearing; what matters is that the last pull before 03:35 has run.
OnCalendar=hourly
# A small spread off the top of the hour, kept well under the 35 minutes between the 03:00 pull and
# the fold.
RandomizedDelaySec=300
# Catch up one missed run after downtime (a box off overnight still ships on the next boot). Re-copies
# are no-ops (rsync -a) and the fold is idempotent, so a catch-up run cannot double-count.
Persistent=true

[Install]
WantedBy=timers.target
