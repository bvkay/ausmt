# The deploy box runs a live checkout of this PUBLIC repo. `deploy/.env` holds the real
# AUSMT_SUBMIT_KEY / AUSMT_CURATOR_KEYS once the gateway is configured (.env.example:9 says to
# gitignore it, but nothing did until this file). One `git add -A` on the box would otherwise stage
# live secrets for a public push, and a leak into public history is permanent. Ignore every `.env`
# variant here; keep the tracked template.
.env
*.env
!.env.example

# Python bytecode + test caches (deploy/tests/ is a pytest dir; mirror gateway/.gitignore so a
# `git add -A` on the box never stages compiled artifacts).
__pycache__/
*.pyc
.pytest_cache/

# The rendered front-door Caddyfile: a VPS deploy artifact install-frontdoor.sh writes from the
# tracked frontdoor/Caddyfile (legacy redirect block templated in or out on the .env state). It can
# carry deployment-specific structure, so it never belongs in git; a `git add -A` on the VPS must
# not stage it.
frontdoor/Caddyfile.rendered
